// MITRE ATT&CK: T1110.003 - Brute Force: Password Spraying
// Description: Detects a single source IP targeting multiple unique user accounts within a 15-minute window via Event 4625.
// Author: Detection Engineering
// Data Source: Windows Security Events (SecurityEvent)

SecurityEvent
| where TimeGenerated > ago(1h)
| where EventID == 4625 // An account failed to log on
// Filter out local machine / loopback noise
| where IpAddress != "-" and IpAddress != "127.0.0.1" and IpAddress != "::1"
| summarize 
    FailedAttempts = count(), 
    UniqueAccountsTargeted = dcount(TargetUserName), 
    TargetedAccountsList = make_set(TargetUserName, 20) 
    by IpAddress, bin(TimeGenerated, 15m)
// Threshold: At least 5 unique accounts targeted from 1 IP within 15 minutes
| where UniqueAccountsTargeted >= 5 and FailedAttempts >= 10
| project TimeGenerated, IpAddress, UniqueAccountsTargeted, FailedAttempts, TargetedAccountsList
| sort by UniqueAccountsTargeted desc
